# School Management - Production Environment Variables
# Copy to .env and fill in values

# Database - Use .NET user-secrets in production
DB_USER=postgres
# DB_PASSWORD = production PostgreSQL password (set via `dotnet user-secrets set DB_PASSWORD <pass>`)

# JWT (required for production) - Use .NET user-secrets in production
# JWT_SECRET = production JWT secret (set via `dotnet user-secrets set JWT_SECRET <secret>`)
# JWT_ISSUER = production JWT issuer (set via `dotnet user-secrets set JWT_ISSUER <url>`)
# JWT_AUDIENCE = production JWT audience (set via `dotnet user-secrets set JWT_AUDIENCE <url>`)

# Auth0 (production) - Use .NET user-secrets in production
# AUTH0_DOMAIN = production Auth0 domain (set via `dotnet user-secrets set AUTH0_DOMAIN <domain>`)
# AUTH0_CLIENT_ID = production Auth0 client ID (set via `dotnet user-secrets set AUTH0_CLIENT_ID <id>`)
# AUTH0_CLIENT_SECRET = production Auth0 client secret (set via `dotnet user-secrets set AUTH0_CLIENT_SECRET <secret>`)
# AUTH0_AUDIENCE = production Auth0 audience (set via `dotnet user-secrets set AUTH0_AUDIENCE <audience>`)

# Stripe (alternative billing provider — não ativo; Asaas é o gateway em uso)
# STRIPE_SECRET_KEY=sk_live_your-secret-key
# STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Asaas (gateway ativo) — no código as chaves são Asaas__ApiKey / Asaas__WebhookToken
# ASAAS_API_KEY = ...
# ASAAS_WEBHOOK_TOKEN = ...

# CORS de produção (formato indexado; domínios Vercel)
# Cors__AllowedOrigins__0 = https://school-management-ui-<hash>.vercel.app
# Cors__AllowedOrigins__1 = https://school-management-ui-three.vercel.app

# Observabilidade (stack local docker)
# OTEL/p Prom: ver monitoring-package-api/observability/ (docker compose)

